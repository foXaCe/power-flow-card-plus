{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":semanticCommitTypeAll(chore)", ":dependencyDashboard", "schedule:nonOfficeHours"],
  "timezone": "Europe/Paris",
  "forkProcessing": "enabled",
  "labels": ["dependencies"],
  "reviewers": ["foXaCe"],
  "assignees": ["foXaCe"],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "rangeStrategy": "auto",
  "rebaseWhen": "auto",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "dependencyDashboardTitle": "\ud83d\udce6 Renovate Dependency Dashboard",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true
  },
  "vulnerabilityAlerts": {
    "labels": ["security", "dependencies"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Pause majors: typescript-eslint n'a pas de version compatible TS7",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Auto-merge low-risk updates once CI is green",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "platformAutomerge": true,
      "addLabels": ["auto-merge"]
    },
    {
      "description": "Review majors manually with a buffer",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major", "needs-review"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "addLabels": ["ci"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "npm packages",
      "matchManagers": ["npm"],
      "addLabels": ["javascript"]
    },
    {
      "description": "Auto-merge dev dependency minor/patch",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge the pnpm packageManager bump (minor/patch); majors stay manual",
      "matchDepNames": ["pnpm"],
      "matchDepTypes": ["packageManager"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "platformAutomerge": true,
      "addLabels": ["auto-merge"]
    },
    {
      "matchPackageNames": ["/^@babel\\//"],
      "groupName": "babel"
    },
    {
      "matchPackageNames": ["/^@rollup\\//", "/^rollup/"],
      "groupName": "rollup"
    },
    {
      "matchPackageNames": ["/eslint/", "/^@typescript-eslint\\//", "globals"],
      "groupName": "eslint"
    },
    {
      "matchPackageNames": ["/^@semantic-release\\//", "/^semantic-release/", "conventional-changelog-conventionalcommits"],
      "groupName": "semantic-release"
    },
    {
      "description": "lit is core runtime \u2014 review manually",
      "matchPackageNames": ["/^lit$/", "/^@lit\\//"],
      "groupName": "lit",
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "matchPackageNames": ["/jest/", "ts-jest", "babel-jest"],
      "groupName": "jest"
    },
    {
      "description": "Tout ce qui monte se fusionne seul quand la CI est verte (op\u00e9rateur, 2026-10-14)",
      "matchUpdateTypes": ["minor", "major"],
      "automerge": true,
      "platformAutomerge": true
    }
  ],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/coverage/**"],
  "rollbackPrs": false
}
